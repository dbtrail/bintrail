# Bintrail Docker Compose configuration.
# Everything is optional — `docker compose up -d` works with no .env at all
# (add servers from the console UI). Copy to .env to pin any of the knobs.
#
#   cp .env.example .env
#   docker compose up -d
#   docker compose logs bintrail    # open the printed console URL

# OPTIONAL — a source MySQL to start watching immediately at boot.
# Leave unset and add servers from the console UI instead (zero-config path).
# The user needs REPLICATION SLAVE, REPLICATION CLIENT, and SELECT.
# `host.docker.internal` reaches a MySQL on this machine from inside Docker.
# SOURCE_DSN=user:password@tcp(host.docker.internal:3306)/

# Optional — comma-separated schemas to track (empty = all user schemas).
SCHEMAS=

# Optional — pin your own console access token. When empty, a token is
# generated on first boot, persisted in the bintrail-state volume (stable
# across restarts), and printed in the logs. Prefer a username+password
# login? Run: docker compose exec -it bintrail bintrail-console user set-password
CONSOLE_TOKEN=

# Optional — pin the bundled index MySQL root password. Leave commented to
# get a randomly-generated one (the default). If you set it, do so BEFORE the
# first `up` — it is baked into the datadir at init and changing it later
# means resetting the index volumes.
# INDEX_MYSQL_ROOT_PASSWORD=

# Optional — bring your own index MySQL instead of the bundled container
# (then you can delete the index-mysql service from docker-compose.yml).
# INDEX_DSN=user:pass@tcp(my-index-host:3306)/bintrail_index

# Optional — pin the image tag (default: latest). Tags of
# ghcr.io/dbtrail/bintrail-console; the console image exists from the first
# release after the console split onward.
# BINTRAIL_TAG=v0.9.0
